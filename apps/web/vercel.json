{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter=@ringback/shared-types build && pnpm --filter=@ringback/flow-engine build && pnpm --filter=@ringbacksms/web build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/recurring-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/review-prompts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/meeting-confirmations",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-recap",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-task-digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reopen-snoozed",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-payouts",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/clear-stale-handoffs",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire-consent-requests",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/conversation-review",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/commerce-webhooks",
      "schedule": "* * * * *"
    }
  ]
}
